# The agent's model. gemini | anthropic | opencode | stub
# stub replays config/stub-script.json: no key, no cost, and not a real model.
MODEL_PROVIDER=stub
# Model for gemini or anthropic. Left empty, each provider uses its default.
MODEL_NAME=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# OpenCode Go, the subscription gateway. Requests go to /zen/go/v1/messages;
# /zen/v1/messages is pay-per-token and refuses a Go key with 402.
OPENCODE_API_KEY=
# Which Go model runs the agent. It must speak /messages and return tool calls:
# minimax-m3, kimi-k3 and qwen3.8-flash are confirmed to.
ZEN_MODEL=
# Override the Go endpoint. Rarely wanted.
OPENCODE_BASE_URL=

# Pin the write-up to gemini or opencode. Empty: whichever keys exist, in that order.
SUMMARY_PROVIDER=

# none: voice is off and says so; typed text still works.
# operator: a person types the transcript, and the record says so.
SPEECH_PROVIDER=none

# Web app that receives the decision log and the wallet ledger. Empty: off.
SHEETS_WEBHOOK_URL=

# Answer FIXTURE calls from fixtures/ without a person. Leave unset for a dry
# run that a person is playing.
OPERATOR_AUTO=

# Pause per scripted step under the stub, in ms, so the work is visible. 0: off.
STUB_THINK_MS=

# SQLite file for the session store.
DATABASE_PATH=data/session.sqlite

PORT=8787
